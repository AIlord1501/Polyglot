# Polyglot Agent Runtime Configuration
# Copy this file to .env and configure your preferred LLM provider.

# Provider selection: "ollama" (default), "gemini", or "openai"
LLM_PROVIDER=ollama

# Local Ollama configuration (default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Google Gemini configuration (optional; overrides Ollama if GEMINI_API_KEY/GOOGLE_API_KEY is set)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible configuration (optional; overrides Ollama if OPENAI_API_KEY is set)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Server ports
GRPC_PORT=50051
HTTP_PORT=8001
